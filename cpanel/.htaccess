# Block direct browsing of sensitive files
<FilesMatch "^(config\.php|bootstrap\.php|layout\.php)$">
  Require all denied
</FilesMatch>

# Default index
DirectoryIndex index.php

# Pretty 404
ErrorDocument 404 /index.php

# Disable directory listing
Options -Indexes

# Force HTTPS (uncomment after enabling SSL in cPanel)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
