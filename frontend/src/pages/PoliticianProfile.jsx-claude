// PoliticianProfile.jsx — orchestrator: fetch, SEO meta, header, tabs.
// Heavy per-tab sections are code-split via React.lazy.
import React, { useEffect, useState, useMemo, useCallback, lazy, Suspense } from "react";
import { useParams } from "react-router-dom";
import { api } from "@/lib/api";
import { PublicLayout } from "@/components/PublicLayout";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Star, CheckCircle2, TrendingUp, Users, FileText, ArrowLeft } from "lucide-react";
import { Link } from "react-router-dom";
import { useAuth } from "@/context/AuthContext";
import { toast } from "sonner";

import SeoHead from "./extensions/PoliticianProfile/SeoHead";
import ProfileHeader from "./extensions/PoliticianProfile/ProfileHeader";
import Overview from "./extensions/PoliticianProfile/Overview";

// Below-the-fold, interactive-only: code-split so recharts/attachment logic
// isn't in the initial bundle.
const Promises = lazy(() => import("./extensions/PoliticianProfile/Promises"));
const WealthHistory = lazy(() => import("./extensions/PoliticianProfile/WealthHistory"));
const Relatives = lazy(() => import("./extensions/PoliticianProfile/Relatives"));
const Media = lazy(() => import("./extensions/PoliticianProfile/Media"));

const TAB_FALLBACK = (
  <div className="animate-pulse space-y-4">
    <div className="h-24 bg-slate-200 rounded-2xl" />
    <div className="h-64 bg-slate-200 rounded-2xl" />
  </div>
);

export default function PoliticianProfile() {
  const { id } = useParams();
  const [p, setP] = useState(null);
  const [error, setError] = useState("");
  const [activeTab, setActiveTab] = useState("overview");
  const [isBookmarked, setIsBookmarked] = useState(false);
  const { user } = useAuth();
  const isAuthed = user && user !== false;

  useEffect(() => {
    const controller = new AbortController();
    api
      .get(`/politicians/${id}`, { signal: controller.signal })
      .then((r) => setP(r.data))
      .catch((e) => {
        if (e.name !== "AbortError") setError(e?.response?.data?.detail || "Not found");
      });
    return () => controller.abort();
  }, [id]);

  // Prefetch tab chunks on idle so switching tabs feels instant, without
  // blocking the critical initial render.
  useEffect(() => {
    if (!p) return;
    const idle = window.requestIdleCallback || ((cb) => setTimeout(cb, 300));
    const cancelIdle = window.cancelIdleCallback || clearTimeout;
    const handle = idle(() => {
      import("./extensions/PoliticianProfile/Promises");
      import("./extensions/PoliticianProfile/WealthHistory");
      import("./extensions/PoliticianProfile/Relatives");
      import("./extensions/PoliticianProfile/Media");
    });
    return () => cancelIdle(handle);
  }, [p]);

  const handleShare = useCallback(() => {
    if (navigator.share) {
      navigator.share({ title: document.title, url: window.location.href }).catch(() => {});
    } else {
      navigator.clipboard.writeText(window.location.href);
      toast.success("Link copied to clipboard!");
    }
  }, []);

  const setPromises = useCallback((promises) => setP((prev) => ({ ...prev, promises })), []);

  if (!p && !error) {
    return (
      <PublicLayout>
        <div className="max-w-5xl mx-auto p-10 mt-16">
          <div className="space-y-4 animate-pulse">
            <div className="h-8 bg-slate-200 rounded-xl w-64" />
            <div className="h-96 bg-slate-200 rounded-2xl" />
            <div className="grid grid-cols-1 lg:grid-cols-[400px_1fr] gap-8">
              <div className="h-[500px] bg-slate-200 rounded-3xl" />
              <div className="space-y-4">
                <div className="h-12 bg-slate-200 rounded-xl w-3/4" />
                <div className="h-24 bg-slate-200 rounded-xl" />
                <div className="grid grid-cols-3 gap-3">
                  <div className="h-24 bg-slate-200 rounded-2xl" />
                  <div className="h-24 bg-slate-200 rounded-2xl" />
                  <div className="h-24 bg-slate-200 rounded-2xl" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </PublicLayout>
    );
  }

  if (error) {
    return (
      <PublicLayout>
        <div className="max-w-3xl mx-auto p-10 mt-16 bg-white/80 backdrop-blur-sm border border-slate-200/50 rounded-2xl shadow-lg text-center">
          <h1 className="font-display font-black text-3xl text-slate-800">Record Not Found</h1>
          <p className="mt-3 text-slate-600">{error}</p>
          <Link to="/" className="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-display font-bold px-8 py-4 rounded-2xl mt-6 transition-all duration-300 hover:scale-105 active:scale-95">
            <ArrowLeft size={16} aria-hidden="true" /> Back to Directory
          </Link>
        </div>
      </PublicLayout>
    );
  }

  return (
    <PublicLayout>
      <SeoHead politician={p} />
      <div className="relative max-w-7xl mx-auto px-4 md:px-8 py-8">
        <div className="absolute inset-0 opacity-[0.02] pointer-events-none" style={{ backgroundImage: "radial-gradient(circle at 1px 1px, #0f172a 1px, transparent 0)", backgroundSize: "24px 24px" }} />
        <div className="absolute top-0 right-1/4 w-96 h-96 bg-emerald-400/10 rounded-full blur-3xl pointer-events-none mix-blend-multiply" />
        <div className="absolute top-1/3 left-1/4 w-96 h-96 bg-blue-400/10 rounded-full blur-3xl pointer-events-none mix-blend-multiply" />
        <div className="absolute bottom-0 left-1/2 w-96 h-96 bg-purple-400/10 rounded-full blur-3xl pointer-events-none mix-blend-multiply" />

        <ProfileHeader p={p} isBookmarked={isBookmarked} onToggleBookmark={() => setIsBookmarked((v) => !v)} onShare={handleShare} />

        <div className="mt-12 relative z-10">
          <Tabs defaultValue="overview" onValueChange={setActiveTab}>
            <TabsList className="w-full justify-start border-b border-slate-200/50 rounded-none bg-transparent p-0 h-auto overflow-x-auto">
              {[
                { v: "overview", l: "Overview", icon: Star },
                { v: "promises", l: "Promises", icon: CheckCircle2 },
                { v: "wealth", l: "Wealth History", icon: TrendingUp },
                { v: "relatives", l: "Relatives", icon: Users },
                { v: "bio", l: "Bio & Media", icon: FileText },
              ].map((t) => (
                <TabsTrigger
                  key={t.v}
                  value={t.v}
                  id={`tab-${t.v}`}
                  data-testid={`tab-${t.v}`}
                  className="rounded-none px-4 md:px-6 py-3 -mb-[2px] border-b-2 border-transparent data-[state=active]:border-indigo-600 data-[state=active]:text-indigo-600 font-bold uppercase tracking-wider text-xs md:text-sm text-slate-500 hover:text-slate-700 transition-all hover:-translate-y-0.5 flex items-center gap-2 whitespace-nowrap"
                >
                  <t.icon size={14} className="opacity-50 data-[state=active]:opacity-100" aria-hidden="true" />
                  {t.l}
                </TabsTrigger>
              ))}
            </TabsList>

            <TabsContent value="overview" className="pt-6">
              <Overview p={p} />
            </TabsContent>

            <TabsContent value="promises" className="pt-6">
              {activeTab === "promises" && (
                <Suspense fallback={TAB_FALLBACK}>
                  <Promises promises={p.promises} politicianId={p.id} isAuthed={isAuthed} user={user} onPromisesChange={setPromises} />
                </Suspense>
              )}
            </TabsContent>

            <TabsContent value="wealth" className="pt-6">
              {activeTab === "wealth" && (
                <Suspense fallback={TAB_FALLBACK}>
                  <WealthHistory wealth={p.wealth} currency={p.currency} />
                </Suspense>
              )}
            </TabsContent>

            <TabsContent value="relatives" className="pt-6">
              {activeTab === "relatives" && (
                <Suspense fallback={TAB_FALLBACK}>
                  <Relatives relatives={p.relatives} defaultCurrency={p.currency} />
                </Suspense>
              )}
            </TabsContent>

            <TabsContent value="bio" className="pt-6">
              {activeTab === "bio" && (
                <Suspense fallback={TAB_FALLBACK}>
                  <Media bioHtml={p.bio_html} media={p.media} />
                </Suspense>
              )}
            </TabsContent>
          </Tabs>
        </div>
      </div>
    </PublicLayout>
  );
}
