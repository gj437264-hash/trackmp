// SeoHead.jsx — title, meta, canonical, OG/Twitter, JSON-LD.
// Uses react-helmet-async if it's already a dependency; falls back to a manual DOM effect otherwise.
import React, { useEffect } from "react";

function upsertMeta(attr, key, content) {
  if (!content) return;
  let el = document.head.querySelector(`meta[${attr}="${key}"]`);
  if (!el) {
    el = document.createElement("meta");
    el.setAttribute(attr, key);
    document.head.appendChild(el);
  }
  el.setAttribute("content", content);
}

function upsertLink(rel, href) {
  if (!href) return;
  let el = document.head.querySelector(`link[rel="${rel}"]`);
  if (!el) {
    el = document.createElement("link");
    el.setAttribute("rel", rel);
    document.head.appendChild(el);
  }
  el.setAttribute("href", href);
}

function upsertJsonLd(id, data) {
  let el = document.getElementById(id);
  if (!el) {
    el = document.createElement("script");
    el.type = "application/ld+json";
    el.id = id;
    document.head.appendChild(el);
  }
  el.textContent = JSON.stringify(data);
}

export default function SeoHead({ politician }) {
  useEffect(() => {
    if (!politician) return;
    const p = politician;
    const title = `${p.name} — ${p.role || "Politician Profile"} | TrackMP`;
    const description =
      p.brief_intro?.slice(0, 155) ||
      `Track ${p.name}'s promises, wealth history, and political record.`;
    const canonical = `${window.location.origin}/politicians/${p.id}`;
    const image = p.image_url || `${window.location.origin}/og-default.png`;

    const prevTitle = document.title;
    document.title = title;

    upsertMeta("name", "description", description);
    upsertLink("canonical", canonical);

    upsertMeta("property", "og:title", title);
    upsertMeta("property", "og:description", description);
    upsertMeta("property", "og:type", "profile");
    upsertMeta("property", "og:url", canonical);
    upsertMeta("property", "og:image", image);

    upsertMeta("name", "twitter:card", "summary_large_image");
    upsertMeta("name", "twitter:title", title);
    upsertMeta("name", "twitter:description", description);
    upsertMeta("name", "twitter:image", image);

    upsertJsonLd("politician-jsonld", {
      "@context": "https://schema.org",
      "@type": "Person",
      name: p.name,
      jobTitle: p.role,
      affiliation: p.party,
      image,
      url: canonical,
      description,
    });

    return () => {
      document.title = prevTitle;
    };
  }, [politician]);

  return null;
}
