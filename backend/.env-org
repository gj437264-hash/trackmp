MONGO_URL="mongodb://localhost:27017"
DB_NAME="trackmp"

# FIX BEFORE PROD: still a placeholder domain, and must be https:// with NO
# trailing slash (a trailing slash means the browser's Origin header will
# never match this value and CORS will silently fail). Comma-separate if
# you need more than one origin, e.g. "https://trackmp.com,https://www.trackmp.com"
CORS_ORIGINS="https://your-domain.com"

JWT_SECRET="2eeed3bfe95e7b0b0ab20efc745bb94cdfeb1a5c53cef7edb23f1f4d1c51c6a3"
# ^ ROTATE THIS before going to production — it was just pasted into a public chat logs.
# Generate a fresh one with: python -c "import secrets; print(secrets.token_hex(32))"

FRONTEND_URL="https://your-domain.com"

UPLOAD_DIR=/opt/trackmp/backend/uploads
PUBLIC_UPLOAD_BASE=/api/uploads

ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
# ^ still literally the placeholder text — must be replaced before prod.

# FIX: SUPER_ADMIN_EMAIL / SUPER_ADMIN_PASSWORD were defined TWICE in the
# original file. With python-dotenv, the LAST value silently wins, so only
# admin@example2.com / Admin@1234 was actually active — the first pair was
# dead weight. If you need two super-admin accounts, your app code needs to
# support a list/array here (e.g. SUPER_ADMIN_EMAILS="a@x.com,b@x.com" and
# handle it as a list), a single env var can't hold two active values.
# Both passwords below are weak test values — replace before prod.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="Admin@123"

# ============================================================
# Added for the image upload/optimization router
# ============================================================

# Comma-separated API keys allowed to upload/delete images.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
UPLOAD_API_KEYS=

# Comma-separated list of valid "context" tags for uploads — extend this
# as you add new pages/forms that accept images.
IMAGE_UPLOAD_CONTEXTS=profile_photo,product_image,blog_cover,listing_photo,politician_photo,generic

# Optional — where images specifically are stored on disk. Defaults to
# <UPLOAD_DIR>/images if left blank, so you likely don't need to set this.
IMAGE_UPLOAD_DIR=

# Optional — leave blank to fall back to in-process caching/rate-limiting
# (fine for a single uvicorn worker). Set this once you run workers > 1.
REDIS_URL=

# Only needed if FastAPI sits behind a local reverse proxy (Nginx/Caddy) on
# the same box, so X-Forwarded-For can be trusted for correct rate-limit
# bucketing. Leave blank if you're not behind a proxy yet.
TRUSTED_PROXY_IP=

# ============================================================
# Additional Security Functions Goes Here
# ============================================================

#This is used to derive anon labels server-side (HMAC of session+article),
#replacing the client-side hash currently in YourVoicePage.jsx.
VOICE_HMAC_SECRET=<run: python3 -c "import secrets; print(secrets.token_hex(32))">

#Google reCaptcha v3 Setup - included On all active forms
RECAPTCHA_SECRET_KEY=6Ld4-mUtAAAAAPsFqzdfiJ2B-8QltAooCerq272x
